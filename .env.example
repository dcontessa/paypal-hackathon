# Copy to .env. Never commit real credentials. Sandbox only.

# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email of a sandbox personal (buyer) account used as the invoice recipient
DEMO_BUYER_EMAIL=

# Anthropic API key for the agent. Without it, Runway uses its offline rule-based planner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
CURRENCY=USD
